# Данные приложения с https://dev.hh.ru/admin
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# Должен совпадать с Redirect URI в настройках приложения
HH_REDIRECT_URI=http://localhost:8765/callback

# hh.ru требует контактную почту в заголовке HH-User-Agent
HH_APP_NAME=KidsUP-HR
HH_APP_EMAIL=

# Только для команд analyze/draft
ANTHROPIC_API_KEY=
